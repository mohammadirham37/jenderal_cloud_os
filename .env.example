# ITK Cloud configuration. Copy to .env (development) or
# /etc/itk-cloud/itk-cloud.env (production, mode 0640 root:itk-cloud).
# Never commit real secrets. Generate secrets with: itkctl gen-secrets

APP_ENV=development
APP_BASE_URL=http://localhost:5173
APP_LOG_LEVEL=debug
# Separate origin for workspace web apps (JupyterLab, dev servers). Must differ
# from APP_BASE_URL. Empty disables the app proxy.
APP_PROXY_ORIGIN=
COOKIE_SECURE=false

API_HOST=127.0.0.1
API_PORT=8080

DATABASE_URL=postgres://itk_cloud:CHANGE_ME@127.0.0.1:5432/itk_cloud?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0

SESSION_SECRET=
ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

AGENT_SOCKET_PATH=/run/itk-cloud/agent.sock
AGENT_SOCKET_GROUP=itk-cloud
AGENT_SHARED_SECRET=
# loopback (enforced quota, Linux, requires root agent) | directory (measured only)
AGENT_STORAGE_DRIVER=loopback
DOCKER_SOCKET=/var/run/docker.sock

WORKSPACE_ROOT=/srv/itk-cloud/workspaces
WORKSPACE_DEFAULT_DRIVER=docker
WORKSPACE_NATIVE_ENABLED=false

UPLOAD_MAX_BYTES=104857600
EDITOR_MAX_BYTES=1048576
TERMINAL_SESSION_TTL_MINUTES=60
TERMINAL_IDLE_TIMEOUT_MINUTES=30

GPU_ENABLED=false
NVIDIA_SMI_PATH=nvidia-smi

BACKUP_ROOT=/srv/itk-cloud/backups
# Second location on another disk/NFS (strongly recommended).
BACKUP_COPY_DIR=
# Public age key (age1...). Generate with: itkctl backup keygen
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14

# Optional: project databases (role with CREATEDB and CREATEROLE, not superuser).
PROJECT_DB_ADMIN_URL=
PROJECT_DB_HOST=127.0.0.1
PROJECT_DB_PORT=5432

# Optional: outgoing email for password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

CONFIG_DIR=/etc/itk-cloud
WEB_HEALTH_URL=
PROMETHEUS_URL=
GRAFANA_URL=
