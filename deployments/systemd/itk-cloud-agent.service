[Unit]
Description=ITK Cloud host agent (allow-listed host operations)
Documentation=file:///opt/itk-cloud/docs/agent-protocol.md
After=network-online.target docker.service local-fs.target
Wants=network-online.target docker.service

[Service]
Type=simple
# The agent needs root for loop-mounting workspace volumes, setting file
# ownership for workspace users and (optionally) creating native workspace
# accounts. Access to its socket is limited to the itk-cloud group and every
# request is HMAC-authenticated; only allow-listed operations exist.
User=root
EnvironmentFile=/etc/itk-cloud/agent.env
ExecStart=/opt/itk-cloud/current/bin/itk-cloud-agent
RuntimeDirectory=itk-cloud
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65536
UMask=0027

CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_SETUID CAP_SETGID CAP_SYS_ADMIN CAP_KILL CAP_SYS_RESOURCE CAP_AUDIT_WRITE CAP_MKNOD
# IMPORTANT: no option that creates a private mount namespace (ProtectSystem,
# ProtectHome, PrivateTmp, ProtectKernelTunables/Modules/Logs, ReadOnlyPaths,
# ...). The agent loop-mounts workspace volumes, and those mounts must be
# visible in the host namespace where Docker bind-mounts them into
# containers; inside a private namespace Docker would see empty directories.
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
