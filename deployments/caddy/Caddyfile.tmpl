# ITK Cloud reverse proxy (generated by installer/install.sh).
# __DOMAIN__ and __PROXY_PORT__ are replaced at install time.
{
	# LAN-only deployment: certificates come from Caddy's internal CA.
	# Distribute the root certificate to lab clients (see docs/installation.md).
	auto_https disable_redirects
}

# Main console: web UI + API.
https://__DOMAIN__ {
	tls internal
	encode zstd gzip

	# Workspace apps are only served on the separate app-proxy origin.
	@appproxy path_regexp ^/api/v1/workspaces/[^/]+/proxy(/.*)?$
	respond @appproxy "Not found" 404

	handle /api/* {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}
	handle /health/* {
		reverse_proxy 127.0.0.1:8080
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		# SAMEORIGIN: console pages are shown inside desktop windows (iframes).
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), usb=()"
		-Server
	}
	log {
		output file /var/log/caddy/itk-cloud-access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}

# Separate origin for web apps running inside workspaces (JupyterLab, dev
# servers). Scripts served here cannot read ITK Cloud API responses.
https://__DOMAIN__:__PROXY_PORT__ {
	tls internal

	@appproxy path_regexp ^/api/v1/workspaces/[^/]+/proxy(/.*)?$
	handle @appproxy {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
		}
	}
	handle {
		respond "Not found" 404
	}
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# Redirect plain HTTP on the LAN to HTTPS.
http://__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}
